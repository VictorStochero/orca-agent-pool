{
  "name": "orca-agent-pool",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "description": "Agent Pool & Test Queue for Orca: an agent pool and a test queue for any language.",
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
