    "lint": "biome check",
    "format": "biome format --write",
    "typecheck:plugin": "tsc --noEmit -p tsconfig.plugin.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
